{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "herds-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"routes": [
		{
			"pattern": "herds-api.metalogrom.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "herds-db",
			"database_id": "cc9a162a-ff2c-4d77-8ff3-e2daeec48c74"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatRoom"
			]
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
}