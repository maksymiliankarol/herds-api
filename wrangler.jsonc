{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "herds-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"vars": {
		"WEB_URL": "https://herds.metalogrom.com",
		"WEB_URL_ADS": "https://herds-ads.metalogrom.com"
	},
	"routes": [
		{
			"pattern": "herds-api.metalogrom.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "herds-db",
			"database_id": "5e77632a-33cd-41db-b0cb-022a1fa4e416"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatRoom"
			]
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}